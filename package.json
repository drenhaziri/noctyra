    "themes": [
      {
        "label": "Noctyra",
        "uiTheme": "vs-dark",
        "path": "./themes/noctyra-color-theme.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
