{
  "name": "noctyra",
  "displayName": "Noctyra",
  "description": "A refined near-black VS Code theme with warm syntax accents, subtle contrast, and a focused editing experience.",
  "version": "1.0.1",
  "publisher": "drenhaziri",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drenhaziri/noctyra-theme.git"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "noctyra",
    "dark theme",
    "near black",
    "minimal",
    "java",
    "csharp",
    "typescript",
    "syntax highlighting"
  ],
  "icon": "images/icon.png",
