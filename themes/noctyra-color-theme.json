{
  "name": "Noctyra",
  "type": "dark",
  "colors": {
    "editor.background": "#1A1A1A",
    "editor.foreground": "#A9B7C6",
    "editorLineNumber.foreground": "#5B626A",
    "editorLineNumber.activeForeground": "#A4AAB0",
    "editorCursor.foreground": "#A9B7C6",
    "editor.selectionBackground": "#214283",
    "editor.inactiveSelectionBackground": "#263B59",
    "editor.lineHighlightBackground": "#1E1E1E",
    "editorIndentGuide.background1": "#2D2D2D",
    "editorIndentGuide.activeBackground1": "#4A4A4A",
    "editorWhitespace.foreground": "#3A3A3A",
    "editorBracketMatch.background": "#3B514D",
    "editorBracketMatch.border": "#00000000",
    "editor.findMatchBackground": "#515C6A",
    "editor.findMatchHighlightBackground": "#32593D88",
    "activityBar.background": "#1A1A1A",
    "activityBar.foreground": "#C8C8C8",
    "activityBar.inactiveForeground": "#777777",
    "activityBar.border": "#292929",
    "activityBarBadge.background": "#3592C4",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#1A1A1A",
    "sideBar.foreground": "#BBBBBB",
    "sideBar.border": "#292929",
    "sideBarTitle.foreground": "#C8C8C8",
    "sideBarSectionHeader.background": "#1A1A1A",
    "sideBarSectionHeader.foreground": "#BEBEBE",
    "sideBarSectionHeader.border": "#292929",
    "list.activeSelectionBackground": "#2B2B2B",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#252525",
    "list.hoverBackground": "#242424",
    "list.focusOutline": "#00000000",
    "titleBar.activeBackground": "#1A1A1A",
    "titleBar.activeForeground": "#CFCFCF",
    "titleBar.inactiveBackground": "#1A1A1A",
    "titleBar.inactiveForeground": "#777777",
    "titleBar.border": "#292929",
    "tab.activeBackground": "#1A1A1A",
    "tab.inactiveBackground": "#1A1A1A",
    "tab.activeForeground": "#D0D0D0",
    "tab.inactiveForeground": "#858585",
    "tab.border": "#292929",
    "tab.activeBorderTop": "#00000000",
    "editorGroupHeader.tabsBackground": "#1A1A1A",
    "editorGroup.border": "#292929",
    "panel.background": "#1A1A1A",
    "panel.border": "#303030",
    "panelTitle.activeForeground": "#D0D0D0",
    "panelTitle.inactiveForeground": "#777777",
    "terminal.background": "#1A1A1A",
    "terminal.foreground": "#D0D0D0",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#CC6666",
    "terminal.ansiGreen": "#B5BD68",
    "terminal.ansiYellow": "#F0C674",
    "terminal.ansiBlue": "#81A2BE",
    "terminal.ansiMagenta": "#B294BB",
    "terminal.ansiCyan": "#8ABEB7",
    "terminal.ansiWhite": "#C5C8C6",
    "statusBar.background": "#1A1A1A",
    "statusBar.foreground": "#BDBDBD",
    "statusBar.border": "#292929",
    "statusBar.noFolderBackground": "#1A1A1A",
    "input.background": "#202020",
    "input.foreground": "#D0D0D0",
    "input.border": "#3A3A3A",
    "dropdown.background": "#202020",
    "dropdown.foreground": "#D0D0D0",
    "dropdown.border": "#3A3A3A",
    "menu.background": "#202020",
    "menu.foreground": "#D0D0D0",
    "menu.selectionBackground": "#2D2D2D",
    "menu.border": "#3A3A3A",
    "scrollbarSlider.background": "#5A5A5A55",
    "scrollbarSlider.hoverBackground": "#6A6A6A77",
    "scrollbarSlider.activeBackground": "#77777799",
    "focusBorder": "#00000000",
    "contrastBorder": "#00000000",
    "widget.border": "#353535",
    "editorWidget.background": "#202020",
    "editorWidget.border": "#353535",
    "peekView.border": "#3A3A3A",
    "peekViewEditor.background": "#1A1A1A",
    "peekViewResult.background": "#1D1D1D"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#606366",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.class",
        "support.type",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#FFC66D"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#B9B9B9"
      }
    },
    {
      "scope": [
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#6A8759"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#6897BB"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E8BF6A"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BABABA"
      }
    },
    {
      "scope": [
        "storage.type.annotation.java",
        "punctuation.definition.annotation.java",
        "entity.name.type.annotation.java"
      ],
      "settings": {
        "foreground": "#BBB529"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF6B68"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#A9B7C6",
    "interface": "#A9B7C6",
    "enum": "#A9B7C6",
    "type": "#A9B7C6",
    "method": "#FFC66D",
    "function": "#FFC66D",
    "parameter": "#B9B9B9",
    "property": "#A9B7C6",
    "variable": "#A9B7C6",
    "enumMember": "#9876AA",
    "decorator": "#BBB529"
  }
}
